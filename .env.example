# Copy to .env and fill in. Real environment variables (e.g. from Docker)
# override this file. Read by config/env.php.

# Site address, with trailing slash
BASE_URL=http://localhost/bpausa/
# dev = emails go to DEVEMAIL for testing; anything else = real recipients
WHATENV=dev

# API (mobile app) token signing key: 64 random characters,
# e.g. openssl rand -hex 32
JWT_SECRET=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=bpausa

# Brevo email
BREVO_SMTP_KEY=
BREVO_API_KEY=
# 1 = sync contacts to Brevo, 0 = no sync
SYNC_BREVO=0

# 1 = Honcho staff back office is deployed (only staff sysadmins reach System
# Settings / Auditlog), 0 = Honcho Lite (member system admins reach them)
HONCHO_MODULE=1
