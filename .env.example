# Copy to .env and fill in. Real environment variables (e.g. from Docker)
# override this file. Read by config/env.php.

# Site address, with trailing slash
BASE_URL=http://localhost/bpausa/
# dev = emails go to DEVEMAIL for testing; anything else = real recipients
WHATENV=dev

# API (mobile app) token signing key: 64 random characters,
# e.g. openssl rand -hex 32
JWT_SECRET=

# Member cards: key that signs the QR codes. Optional - when blank a key is derived
# from JWT_SECRET. Changing it (or JWT_SECRET while this is blank) cancels every card.
# e.g. openssl rand -hex 32
CARD_SECRET=

# Credential vault (vault_helper.php): encrypts secrets stored in the database, such as each
# National/chapter AI API key. Optional - when blank a key is derived from JWT_SECRET.
# Changing it (or JWT_SECRET while this is blank) makes every stored key unreadable: re-enter them.
# e.g. openssl rand -hex 32
VAULT_KEY=

# Google Wallet for member cards (wallet_helper.php). Issuer ID from the Google Pay & Wallet
# Console; the key file is the service account's JSON key, kept OUTSIDE the project, never committed.
# The service account must be added in the Wallet console under Users as a Developer.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_FILE=
# Optional: a public https logo Google can fetch for the card
GOOGLE_WALLET_LOGO_URL=
# Optional: keeps this install's card ids apart on a shared issuer (default: from BASE_URL)
GOOGLE_WALLET_PREFIX=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=bpausa

# Brevo email
BREVO_SMTP_KEY=
BREVO_API_KEY=
# 1 = sync contacts to Brevo, 0 = no sync
SYNC_BREVO=0

# SMTP email (forgot password). For Gmail use an app password, not the account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# 1 = Honcho staff back office is deployed (only staff sysadmins reach System
# Settings / Auditlog), 0 = Honcho Lite (member system admins reach them)
HONCHO_MODULE=1
# The public website and member sticky-note switches (CMS_PUBLIC_SITE,
# CMS_MEMBER_BULLETINS) moved to System Settings > Features & Policy on 2026-10-22.
