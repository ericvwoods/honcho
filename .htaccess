<IfModule mod_headers.c>
    Header set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

# Never serve the settings file
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine on
  RewriteRule ^$ public/ [L]
  RewriteRule (.*) public/$1 [L]
</IfModule>